# Copy this file to .env and fill in real values. .env is gitignored.
# Defaults shown here target the local docker-compose stack (Postgres, Redis,
# Mailpit). Swap the mail block for real SMTP only if you want live delivery.

# --- Environment ---
# Picks the database schema (ADR 0003): dev -> test, prod -> public.
# Without it the app refuses to start.
SPRING_PROFILES_ACTIVE=dev

# --- Postgres ---
POSTGRES_USER=flowerplus
POSTGRES_PASSWORD=changeme
POSTGRES_DB=flowerplus
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- JWT ---
# Generate a secret with:  openssl rand -base64 64
JWT_SECRET_KEY=replace-with-a-base64-256-bit-key
JWT_EXPIRATION=86400000            # access token lifetime, ms (24h)
JWT_REFRESH_EXPIRATION=604800000   # refresh token lifetime, ms (7d)

# --- OAuth2 (from the Google Cloud console) ---
# Authorized redirect URI to register with Google:
#   http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH2_REDIRECT_URI=http://localhost:8080/swagger-ui/index.html

# --- Email / SMTP ---
# Mailpit (dev): host=localhost port=1025, auth+tls OFF, view mail at :8025.
# Real Gmail:    host=smtp.gmail.com port=587, auth+tls ON, use an app password.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USERNAME=flowerplus@example.com
EMAIL_PASSWORD=unused-for-mailpit
EMAIL_FROM=flowerplus@example.com
MAIL_SMTP_AUTH=false
MAIL_SMTP_TLS=false

# --- Redis (OTP store) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- OTP policy ---
OTP_TTL=5m              # how long a code stays valid
OTP_MAX_ATTEMPTS=5      # wrong guesses before a code is destroyed
OTP_RESEND_INTERVAL=60s # minimum gap between sends to one address
# password-reset codes one address may receive per 24 hours
OTP_RESET_DAILY_LIMIT=5

# --- Admin account ---
# Created at startup when no admin exists. The app refuses to start without
# these. Password: 8-72 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
